<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the engine-independent code in WorkbenchConnect/Linking without referencing the game. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\WorkbenchConnect\Linking\**\*.cs" LinkBase="Linking" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
