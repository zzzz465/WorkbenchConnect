<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scripted in-game checks (see README.md next to this file). Not part of the solution build.
    Builds into Mod/1.7/Assemblies; copy Mod/ into RimWorld/Mods as WCTestDriver.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WCTestDriver</AssemblyName>
    <DebugType>none</DebugType>
    <OutputPath>Mod\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorld17Dir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorld17Dir)\UnityStubs.dll" Private="false" />
    <Reference Include="WorkbenchConnect" HintPath="..\..\..\1.7\Assemblies\WorkbenchConnect.dll" Private="false" />
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
